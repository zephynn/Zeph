# YouTube Data API v3 key — server-only, never exposed to the client.
# Create one at https://console.cloud.google.com/apis/credentials with the
# YouTube Data API v3 enabled, and set it in Vercel's Environment Variables
# (or a local .env file for `vercel dev`).
YOUTUBE_API_KEY=

# Redis (view counter). If you added the "Upstash" integration from Vercel's
# Marketplace, these are auto-populated — note the legacy KV_* names, not
# UPSTASH_REDIS_REST_URL/TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
